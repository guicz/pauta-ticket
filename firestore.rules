rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isTeamMember() {
      return request.auth != null
        && request.auth.token.email in [
          'patricia@dg5.com.br',
          'guilherme@dg5.com.br'
        ];
    }

    match /workspaces/pauta-fluxo {
      allow read, write: if isTeamMember();
    }

    match /demandRequests/{requestId} {
      allow create: if request.auth != null
        && request.resource.data.requesterUid == request.auth.uid
        && request.resource.data.requesterEmail == request.auth.token.email
        && request.resource.data.requester == 'atendimento'
        && request.resource.data.assignee == 'pati'
        && request.resource.data.status == 'inbox';
      allow read: if request.auth != null && (
        request.auth.token.email == 'patricia@dg5.com.br'
        || resource.data.requesterUid == request.auth.uid
      );
      allow update: if request.auth != null
        && request.auth.token.email == 'patricia@dg5.com.br'
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['requesterUid', 'requesterEmail']);
    }

    match /userInboxes/{uid}/items/{item} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        && request.resource.data.read is bool;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
