{
  "name": "pauta-fluxo",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "deploy": "npm run build && firebase deploy --only hosting",
    "test": "vitest run --exclude functions/**",
    "test:watch": "vitest --exclude functions/**",
    "test:services": "npm test --prefix functions",
    "deploy:services": "npm run build && firebase deploy --config firebase.services.json --only functions,firestore,hosting"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "firebase": "^12.18.0",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "firebase-tools": "^15.29.0",
    "typescript": "latest",
    "vitest": "latest"
  }
}
